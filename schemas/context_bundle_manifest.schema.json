{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AuthorityState": {
      "enum": [
        "Accepted",
        "ConflictResolved",
        "ConflictUnresolved"
      ],
      "type": "string"
    },
    "FreshnessBand": {
      "enum": [
        "Fresh",
        "NearLimit"
      ],
      "type": "string"
    },
    "OverrideDecision": {
      "enum": [
        "NoOverridePresent",
        "AllowedStyleRuleOverrideUsed"
      ],
      "type": "string"
    },
    "ReplayEligibility": {
      "enum": [
        "Eligible"
      ],
      "type": "string"
    },
    "SourceClass": {
      "enum": [
        "ActiveScene",
        "AdjacentSceneSummaryOrClippedBody",
        "AcceptedLoreRecord",
        "AcceptedStyleRuleRecord",
        "GovernedMemoryFact",
        "ExperimentalFutureSource"
      ],
      "type": "string"
    },
    "SourceInventoryEntry": {
      "properties": {
        "age_minutes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "authority_state": {
          "$ref": "#/definitions/AuthorityState"
        },
        "is_override": {
          "type": "boolean"
        },
        "payload_ref": {
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_class": {
          "$ref": "#/definitions/SourceClass"
        }
      },
      "required": [
        "age_minutes",
        "authority_state",
        "is_override",
        "payload_ref",
        "source_class"
      ],
      "type": "object"
    },
    "SourceProvenance": {
      "description": "Where a governed memory source came from and under what authority.\n\nEvery field is a reference. Nothing here carries memory content: this records *which* fact a bundle rested on, not what the fact said.",
      "properties": {
        "authority_ref": {
          "description": "What authorized its use here — typically a `memory_residency_policy` reference. Recorded, never authenticated here.",
          "type": "string"
        },
        "memory_ref": {
          "description": "The memory fact, in forge_contract_core reference grammar: `<artifact_family>:<artifact_id>:v<artifact_version>`.",
          "type": "string"
        },
        "retrieval_receipt_ref": {
          "description": "The `memory_retrieval_receipt` that supplied it.",
          "type": "string"
        }
      },
      "required": [
        "authority_ref",
        "memory_ref",
        "retrieval_receipt_ref"
      ],
      "type": "object"
    }
  },
  "properties": {
    "authority_conflict_flag": {
      "type": "boolean"
    },
    "bundle_hash": {
      "type": "string"
    },
    "context_bundle_id": {
      "type": "string"
    },
    "freshness_band": {
      "$ref": "#/definitions/FreshnessBand"
    },
    "override_decision": {
      "$ref": "#/definitions/OverrideDecision"
    },
    "replay_eligibility": {
      "$ref": "#/definitions/ReplayEligibility"
    },
    "source_inventory": {
      "items": {
        "$ref": "#/definitions/SourceInventoryEntry"
      },
      "type": "array"
    }
  },
  "required": [
    "authority_conflict_flag",
    "bundle_hash",
    "context_bundle_id",
    "freshness_band",
    "override_decision",
    "replay_eligibility",
    "source_inventory"
  ],
  "title": "ContextBundleManifest",
  "type": "object"
}