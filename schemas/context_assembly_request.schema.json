{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AuthorityState": {
      "enum": [
        "Accepted",
        "ConflictResolved",
        "ConflictUnresolved"
      ],
      "type": "string"
    },
    "FreshnessPolicy": {
      "properties": {
        "max_source_age_minutes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "max_source_age_minutes"
      ],
      "type": "object"
    },
    "OverridePosture": {
      "enum": [
        "DisallowAll",
        "AllowAcceptedStyleRuleRecords"
      ],
      "type": "string"
    },
    "SourceClass": {
      "enum": [
        "ActiveScene",
        "AdjacentSceneSummaryOrClippedBody",
        "AcceptedLoreRecord",
        "AcceptedStyleRuleRecord",
        "GovernedMemoryFact",
        "ExperimentalFutureSource"
      ],
      "type": "string"
    },
    "SourceInput": {
      "properties": {
        "age_minutes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "authority_state": {
          "$ref": "#/definitions/AuthorityState"
        },
        "is_override": {
          "type": "boolean"
        },
        "payload_ref": {
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceProvenance"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required for [`SourceClass::GovernedMemoryFact`], absent otherwise.\n\nOptional in the type so every existing caller keeps compiling and every existing serialized request keeps deserializing; mandatory in the rule so a memory fact that cannot say where it came from is refused rather than admitted unlabelled. Optional alone would not be fail-closed, and required alone would break every manuscript caller. Neither is enough by itself."
        },
        "source_class": {
          "$ref": "#/definitions/SourceClass"
        }
      },
      "required": [
        "age_minutes",
        "authority_state",
        "is_override",
        "payload_ref",
        "source_class"
      ],
      "type": "object"
    },
    "SourceProvenance": {
      "description": "Where a governed memory source came from and under what authority.\n\nEvery field is a reference. Nothing here carries memory content: this records *which* fact a bundle rested on, not what the fact said.",
      "properties": {
        "authority_ref": {
          "description": "What authorized its use here — typically a `memory_residency_policy` reference. Recorded, never authenticated here.",
          "type": "string"
        },
        "memory_ref": {
          "description": "The memory fact, in forge_contract_core reference grammar: `<artifact_family>:<artifact_id>:v<artifact_version>`.",
          "type": "string"
        },
        "retrieval_receipt_ref": {
          "description": "The `memory_retrieval_receipt` that supplied it.",
          "type": "string"
        }
      },
      "required": [
        "authority_ref",
        "memory_ref",
        "retrieval_receipt_ref"
      ],
      "type": "object"
    },
    "TargetRefs": {
      "properties": {
        "accepted_lore_record_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "accepted_style_rule_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "active_scene_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "adjacent_scene_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "accepted_lore_record_refs",
        "accepted_style_rule_refs"
      ],
      "type": "object"
    }
  },
  "properties": {
    "allowed_source_classes": {
      "items": {
        "$ref": "#/definitions/SourceClass"
      },
      "type": "array"
    },
    "freshness_policy": {
      "$ref": "#/definitions/FreshnessPolicy"
    },
    "override_posture": {
      "$ref": "#/definitions/OverridePosture"
    },
    "sources": {
      "items": {
        "$ref": "#/definitions/SourceInput"
      },
      "type": "array"
    },
    "target_refs": {
      "$ref": "#/definitions/TargetRefs"
    },
    "task_family": {
      "type": "string"
    },
    "task_intent_id": {
      "type": "string"
    },
    "task_version": {
      "type": "string"
    }
  },
  "required": [
    "allowed_source_classes",
    "freshness_policy",
    "override_posture",
    "sources",
    "target_refs",
    "task_family",
    "task_intent_id",
    "task_version"
  ],
  "title": "ContextAssemblyRequest",
  "type": "object"
}